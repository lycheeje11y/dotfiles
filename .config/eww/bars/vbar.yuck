;; system vars
(defpoll HOST :interval "5s" `hostname`)
(defpoll CPU_USAGE :interval "1s" `scripts/sys_info --cpu`)
(defpoll MEM_USAGE :interval "1s" `scripts/sys_info --mem`)
(defpoll DISK_USAGE :interval "1s" `scripts/sys_info --disk`)
(defpoll BLIGHT :interval "1s" `scripts/sys_info --blight`)
(defpoll BATTERY :interval "5s" `scripts/battery --icon`)
(defpoll QUOTE :interval "5m" `scripts/quotes`)
(deflisten ACTIVE_WORKSPACE :initial "1" "scripts/active-workspace")

(defwidget workspaces []
  (box :class "workspaces"
       :orientation "v"
       :halign "center"
       :valign "center"
       (button :onclick "hyprctl dispatch workspace 1"
               :class {ACTIVE_WORKSPACE == 1 ? "item workspace active " : "item workspace"}
               1)
       (button :onclick "hyprctl dispatch workspace 2"
               :class {ACTIVE_WORKSPACE == 2 ? "item workspace active" : "item workspace"}
               2)
       (button :onclick "hyprctl dispatch workspace 3"
               :class {ACTIVE_WORKSPACE == 3 ? "item workspace active" : "item workspace"}
               3)
       (button :onclick "hyprctl dispatch workspace 4"
               :class {ACTIVE_WORKSPACE == 4 ? "item workspace active" : "item workspace"}
               4)
       (button :onclick "hyprctl dispatch workspace 5"
               :class {ACTIVE_WORKSPACE == 5 ? "item workspace active" : "item workspace"}
               5)
       (button :onclick "hyprctl dispatch workspace 6"
               :class {ACTIVE_WORKSPACE == 6 ? "item workspace active" : "item workspace"}
               6)
       (button :onclick "hyprctl dispatch workspace 7"
               :class {ACTIVE_WORKSPACE == 7 ? "item workspace active" : "item workspace"}
               7)
       (button :onclick "hyprctl dispatch workspace 8"
               :class {ACTIVE_WORKSPACE == 8 ? "item workspace active" : "item workspace"}
               8)
       (button :onclick "hyprctl dispatch workspace 9"
               :class {ACTIVE_WORKSPACE == 9 ? "item workspaces active" : "item workspace"}
               9)))

(defwidget middle []
  (workspaces))

(defwidget menu []
					(button :class "item launcher"
										:onclick "~/.config/rofi/launchers/type-3/launcher.sh"
										:onrightclick "~/.config/rofi/powermenu/type-4/powermenu.sh"
                    :timeout "50000ms"
										:tooltip "leftclick: launcher; rightclick: powermenu"
										""))

(defwidget time []
	(box	:orientation "v"
			:class "time label item"
			:valign "end"
	(label :text hour)
	(label :text min)))
(defpoll hour :interval "1s"	"date '+%H'")
(defpoll min :interval "1s"	"date '+%M'")

(defwidget date []
	(box	:orientation "v"
			:class "date label item"
			:valign "end"
	(label :text month)
	(label :text day)))
(defpoll month	:interval "1s"	"date '+%b'")
(defpoll day	:interval "1s"	"date '+%d'")

(defwidget network []
	(label :class "item label"
				 :text network_icon
				 :tooltip network_status))
(defpoll network_icon :interval "5s" "scripts/network --icon")
(defpoll network_status :interval "5s" "scripts/network --stat")

(defwidget idkwhythishelps []
	(box :orientation "v" :valign "start" :style "margin: 0"
		(menu)
		(time)
		(date)
		(opentray)
		))


;; there is a corresponding keybind in hyprland config ($modKey T)
(defwidget opentray []
					(box
					:class "item label opentray"
					(eventbox :onhover "eww open tray --toggle"
										:tooltip "System Tray"
										:valign "fill"
										"󰍜"
										)))

(defwindow tray
					 :monitor "0"
					 :exclusive "false"
					 :wm-ignore "false"
					 :stacking "overlay"
					 :geometry
					 (geometry :anchor "top left" :x -54 :y 330)
									(eventbox	:onhoverlost "eww open tray --toggle"
															(box	:class "item"
																		(systray  :orientation "v"
																						:spacing 10
																						:space-evenly "false"
																						:icon-size 22))))

(defwidget top []
	(box :orientation "v"
	 (idkwhythishelps)
	 ))

(defwidget volume []
		(box
			:class "item"
			:orientation "v"
			(box :orientation "v"
				(label :text volume_icon :class "icon" )
				(label :text "${volume.volume}%" :class "volume label"))))
(deflisten volume :initial '{ "volume": 0, "muted": "false" }' "scripts/listen-volume.sh")
(defpoll volume_icon :interval "1s"
  "scripts/volume --icon")

(defwidget battery []
	(box :orientation "v"
		:class "item"
		(label
			:text battery_icon
			:class "icon")
		(label :text battery :class "battery label")))
(defpoll battery_icon :interval "1s"
  "scripts/battery --icon")
(defpoll battery :interval "1s"
  "scripts/battery --perc")

(defwidget cpu []
					 (box :orientation "v"
								:class "item"
								(label :text "" :class "icon")
								(label :text "${round(EWW_CPU.avg, 0)}%" :class "label")))

(defwidget updates []
	(box :orientation "v"
		:class "item"
		(label :text "" :class "icon")
		(label :text updates :class "label")))
(defpoll updates :interval "5m" "scripts/arch-updates.sh")

(defwidget bottom []
	  (box :class "" :orientation "v" :valign "end"
				(volume)
				(battery)
				(cpu)
				(updates)))

(defwidget bar []
	(centerbox
		:orientation "v"
		(top)
		(workspaces)
		(bottom)
	))

(defwindow vbar
	:monitor 0
	:geometry (geometry :x "0"
							:y "0"
							:height "100%"
							:width "10"
							:anchor "center right")
	:stacking "fg"
	:exclusive "true"
	:windowtype "normal"
	:focusable "none"
	(bar))

