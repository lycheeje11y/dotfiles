(defwidget middle []
	(workspaces))

(defwidget menu []
					(button :class "item launcher"
										:onclick "~/.config/rofi/launchers/type-3/launcher.sh"
										:onrightclick "~/.config/rofi/powermenu/type-4/powermenu.sh"
										:timeout "50000ms"
										:tooltip "leftclick: launcher; rightclick: powermenu"
										""))

(defwidget time []
	(box	:orientation "v"
			:class "time label item"
			:valign "end"
	(label :text hour)
	(label :text min)))
(defpoll hour :interval "1s"	"date '+%H'")
(defpoll min :interval "1s"	"date '+%M'")

(defwidget date []
	(box	:orientation "v"
			:class "date label item"
			:valign "end"
	(label :text month)
	(label :text day)))
(defpoll month	:interval "1s"	"date '+%b'")
(defpoll day	:interval "1s"	"date '+%d'")

(defwidget network []
	(label :class "item label"
				 :text network_icon
				 :tooltip network_status))
(defpoll network_icon :interval "5s" "scripts/network --icon")
(defpoll network_status :interval "5s" "scripts/network --stat")


;; there is a corresponding keybind in hyprland config ($modKey T)
(defvar tray_reveal "false")
(defwidget opentray []
	(eventbox :onhover "eww update tray_reveal=true"
						:onhoverlost "eww update tray_reveal=false"
						:class "tray_eventbox"
						:valign "start"
						(box :space-evenly "false" :orientation "v" :spacing "3" :class "item"
							(label :text "" :class "label" )
							(revealer :transition "slidedown"
									:reveal tray_reveal
									:duration "350ms"
									(systray  :orientation "v"
														:spacing 10
														:class "systemtray"
														:space-evenly "false"
														:icon-size 22)))))

(defwidget idkwhythishelps []
	(box :orientation "v" :valign "start"
		(menu)
		(time)
		(date)
		))

(defwidget top []
	(box :orientation "v" :valign "start"
	 (idkwhythishelps)
	 (opentray)))

(defwidget volume []
		(box
			:class "item"
			:orientation "v"
			(box :orientation "v"
				(label :text volume_icon :class "icon" )
				(label :text "${volume.volume}%" :class "volume label"))))
(deflisten volume :initial '{ "volume": 0, "muted": "false" }' "scripts/listen-volume.sh")
(defpoll volume_icon :interval "1s"
	"scripts/volume --icon")

(defwidget battery []
	(box :orientation "v"
		:class "item"
		(label
			:text battery_icon
			:class "icon")
		(label :text battery :class "battery label")))
(defpoll battery_icon :interval "1s"
	"scripts/battery --icon")
(defpoll battery :interval "1s"
	"scripts/battery --perc")

(defwidget cpu []
					 (box :orientation "v"
								:class "item"
								(label :text "" :class "icon")
								(label :text "${round(EWW_CPU.avg, 0)}%" :class "label")))

(defwidget updates []
	(box :orientation "v"
		:class "item"
		(label :text "" :class "icon")
		(label :text updates :class "label")))
(defpoll updates :interval "5m" "scripts/arch-updates.sh")

(defwidget bottom []
		(box :class "" :orientation "v" :valign "end"
				(volume)
				(battery)
				(cpu)
				(updates)))

(defwidget bar []
	(box
		:orientation "v"
		(top)
		(bottom)
	))

(defwindow vbar
	:monitor 0
	:geometry (geometry :x "0"
							:y "0"
							:height "100%"
							:width "10"
							:anchor "center left")
	:stacking "fg"
	:exclusive "true"
	:windowtype "normal"
	:focusable "none"
	(bar))
