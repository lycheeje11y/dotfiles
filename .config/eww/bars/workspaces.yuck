(deflisten ACTIVE_WORKSPACE :initial "1" "scripts/active-workspace")
(defvar workspaces_reveal "false")

(defvar workspaces "[1, 2, 3, 4, 5, 6, 7, 8, 9]")

(defwidget workspaces []
  (box :class "workspaces_widget"
       :orientation "h"
			 :valign "center"
			 :spacing "10"
       (for workspace in workspaces
         (button :onclick (format "hyprctl dispatch workspace %d" i)
                 :class "workspace ${ACTIVE_WORKSPACE == workspace ? 'active' : ''}"
                 "${workspace}"))))

(defwindow workspaces
	:monitor 0
	:geometry (geometry :x "0"
							:y "0"
							:width "10"
							:anchor "center")
	:stacking "fg"
	:windowtype "normal"
 	:focusable "none"
 	(revealer :transition "slideright" :duration "200ms"  :reveal workspaces_reveal (workspaces)))


