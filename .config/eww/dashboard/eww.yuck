; VARIABLES ******************************************************************

;; profile
(defpoll NAME :interval "10m" "whoami")
(defvar FULLNAME "Joey Wu")
(defvar PFP "dashboard/assets/pfp.png")
(defpoll UPTIME :interval "1s" "uptime -p")

;; fortune
;(defpoll FORTUNE :interval "10s" "scripts/get-fortune")
(defvar FORTUNE "Be the PR you want to see in the world")

;; media
(defpoll TITLE :interval "1s" "scripts/media title")
(defpoll ARTIST :interval "1s" "scripts/media artist")
(defpoll ALBUM :interval "1s" "scripts/media album")
(defpoll ARTWORK :interval "1s" "scripts/media artwork")
(defpoll STATUS :interval "0.4s" "scripts/media status")


;; WIDGETS ******************************************************************
;; profile
(defwidget profile []
					 (box :orientation "v"
								:valign "center"
								:spacing 0 :space-evenly "false"
								:vexpand "false" :hexpand "false"
								:class "window"

								(box :class "pfp" :vexpand "false" :hexpand "false" :style "background-image: url('${PFP}');")
								(label :class "username ":halign "center" :wrap "true" :limit-width "25" :text "${NAME}")
								(label :class "fullname" :halign "center" :wrap "true"
											 :limit-width "20" :text "${FULLNAME}")
								(label :class "uptime" :halign "center" :wrap "true" :limit-width "25"
											 :text "${UPTIME}")
								))

;; media
(defwidget media []
	(box :orientation "h" :valign "fill"
			 :hexpand "false" :vexpand "false"
			 :space-evenly "false" :class "window"
			 :spacing 15
			 ;; (box :class "album-artwork"
			 ;;				:vexpand "false"
			 ;;				:hexpand "false"
			 ;;				:tooltip {ALBUM}
			 ;;				:style "background: no-repeat center/80% url('${ARTWORK}')")
			 ;; (image :path {ARTWORK}
			 ;;					:class "album-artwork"
			 ;;					:vexpand "false"
			 ;;					:hexpand "false"
			 ;;					:image-width 150
			 ;;					:height 150
			 ;;					:width 150
			 ;;					:preserve-aspect-ratio "true")
			(box :class "album-artwork" :vexpand "false" :hexpand "false" :style "background-image: url('${ARTWORK}');")
				(box :orientation "v" :space-evenly "false" :valign "center" :halign "start" :class "media-right"
						:tooltip {ALBUM}
					(label :text {ARTIST} :class "artist" :limit-width "20" :wrap true :tooltip {ALBUM})
					(label :text {TITLE}  :class "title" :limit-width "20" :wrap false :tooltip {ALBUM})
					(box :class "buttons" :orientation "h" :halign "center"  :space-evenly "false"
							 (button :class "prev media-button" :onclick "scripts/media prev" "󰒮")
							 (button :class "play-pause media-button" :onclick "scripts/media play-pause" {STATUS == "Playing" ? "" : ""})
							 (button :class "next media-button" :onclick "scripts/media next" "󰒭")))))


(defwidget fortune []
					 (label :class "window quotes" :width "500" :height "133"  :hexpand "false" :vexpand "false" :limit-width "5" :wrap "true" :text "${FORTUNE}"))


;; WINDOWS ******************************************************************
(defwindow profile
					 :monitor 0
					 :geometry (geometry :x "5"
															 :y "5"
															 :width "230"
															 :anchor "top left")
					 :stacking "bg"
					 :reserve (struts :distance "80px" :side "top")
					 :focusable "none"
					 (profile))

(defwindow media
					 :monitor 0
					 :geometry (geometry :x "250"
															 :y "5"
															 :width "500"
															 :anchor "top left")
					 :stacking "bg"
					 :reserve (struts :distance "80px" :side "top")
					 :focusable "none"
					 (media))

(defwindow fortune
					 :monitor 0
					 :geometry (geometry :x "250"
															 :y "250"
															 :width "200"
															 :anchor "top left")
					 :stacking "bg"
					 :reserve (struts :distance "80px" :side "top")
					 :focusable "none"
					 (fortune))
